<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- MenuActivity - Màn hình chính với các nút bài tập -->
        <activity
            android:name=".MenuActivity"
            android:exported="true"
            android:label="Menu Ứng Dụng Học Tập"
            android:theme="@style/Theme.MyApplication.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity - Màn hình Compose cho khóa học và danh bạ -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.MyApplication"
            tools:node="remove" />

        <!-- Bài 1: Máy tính Mini -->
        <activity
            android:name=".ui.CalculatorActivity"
            android:exported="false"
            android:label="Máy tính Mini"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- Bài 2: Thư viện ảnh -->
        <activity
            android:name=".ui.GalleryActivity"
            android:exported="false"
            android:label="Thư viện ảnh"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- Bài 3: Thời tiết -->
        <activity
            android:name=".ui.WeatherActivity"
            android:exported="false"
            android:label="Thời tiết"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <activity
            android:name=".ui.WeatherDetailActivity"
            android:exported="false"
            android:label="Chi tiết thời tiết"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- Bài 4: S-Task -->
        <activity
            android:name=".ui.TaskActivity"
            android:exported="false"
            android:label="S-Task"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- Danh bạ và Tin nhắn -->
        <activity
            android:name=".ui.ContactListActivity"
            android:exported="false"
            android:label="Danh bạ"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <activity
            android:name=".ui.MessageScreenActivity"
            android:exported="false"
            android:label="Tin nhắn"
            android:theme="@style/Theme.MyApplication.AppCompat" />

        <!-- FileProvider for sharing images -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>