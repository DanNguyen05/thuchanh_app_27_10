<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên công việc"
            android:textSize="13sp"
            android:textColor="#8E8E93"
            android:layout_marginBottom="8dp"
            android:textAllCaps="true"/>

        <EditText
            android:id="@+id/etTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập tên công việc"
            android:inputType="text"
            android:textSize="17sp"
            android:padding="12dp"
            android:background="@drawable/edittext_ios_bg"
            android:textColor="#000000"
            android:textColorHint="#C7C7CC"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mô tả"
            android:textSize="13sp"
            android:textColor="#8E8E93"
            android:layout_marginBottom="8dp"
            android:textAllCaps="true"/>

        <EditText
            android:id="@+id/etTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập mô tả chi tiết"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textSize="17sp"
            android:padding="12dp"
            android:background="@drawable/edittext_ios_bg"
            android:textColor="#000000"
            android:textColorHint="#C7C7CC"
            android:gravity="top|start"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hạn hoàn thành"
            android:textSize="13sp"
            android:textColor="#8E8E93"
            android:layout_marginBottom="8dp"
            android:textAllCaps="true"/>

        <EditText
            android:id="@+id/etTaskDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="VD: 30/12/2024"
            android:inputType="text"
            android:textSize="17sp"
            android:padding="12dp"
            android:background="@drawable/edittext_ios_bg"
            android:textColor="#000000"
            android:textColorHint="#C7C7CC"
            android:drawableStart="@android:drawable/ic_menu_my_calendar"
            android:drawablePadding="8dp"/>

    </LinearLayout>
</ScrollView>
